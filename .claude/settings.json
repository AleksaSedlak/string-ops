{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/skills/status/on-start.sh" },
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/skills/refresh-repos/remind.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/skills/dispatch/watch.sh --hook", "asyncRewake": true, "timeout": 21600 }
        ]
      }
    ]
  }
}

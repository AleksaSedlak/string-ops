{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ls:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(mkdir -p:*)",
      "Bash(diff:*)",
      "Bash(pnpm:*)",
      "Bash(bun:*)",
      "Bash(deno:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pytest:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(uv:*)",
      "Bash(poetry:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(go:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint:*)",
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(rustfmt:*)",
      "Bash(ruby:*)",
      "Bash(bundle:*)",
      "Bash(rake:*)",
      "Bash(rspec:*)",
      "Bash(mvn:*)",
      "Bash(gradle:*)",
      "Bash(./gradlew:*)",
      "Bash(./mvnw:*)",
      "Bash(java:*)",
      "Bash(kotlin:*)",
      "Bash(dotnet:*)",
      "Bash(php:*)",
      "Bash(composer:*)",
      "Bash(phpunit:*)",
      "Bash(make:*)",
      "Bash(cmake:*)",
      "Bash(mix:*)",
      "Bash(swift:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gcloud:*)",
      "Bash(kubectl:*)",
      "Bash(vercel:*)",
      "Bash(npm publish:*)",
      "Bash(npm version:*)",
      "Read(**/.npmrc)",
      "Read(**/.secrets/**)",
      "Read(**/*.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/.npmrc)",
      "Edit(**/.secrets/**)",
      "Bash(cargo publish:*)",
      "Bash(gem push:*)",
      "Bash(twine:*)",
      "Bash(poetry publish:*)",
      "Bash(uv publish:*)",
      "Bash(mvn deploy:*)",
      "Bash(gradle publish:*)",
      "Bash(dotnet nuget push:*)",
      "Bash(composer publish:*)",
      "Bash(mix hex.publish:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__SKILL_DIR__/guard.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|agent_needs_input|elicitation_dialog|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "__SKILL_DIR__/notify.sh"
          }
        ]
      }
    ]
  }
}

{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ls:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(mkdir -p:*)",
      "Bash(diff:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gcloud:*)",
      "Bash(kubectl:*)",
      "Bash(vercel:*)",
      "Bash(npm publish:*)",
      "Bash(npm version:*)",
      "Read(**/.npmrc)",
      "Read(**/.secrets/**)",
      "Read(**/*.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/.npmrc)",
      "Edit(**/.secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__SKILL_DIR__/guard.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|agent_needs_input|elicitation_dialog|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "__SKILL_DIR__/notify.sh"
          }
        ]
      }
    ]
  }
}
